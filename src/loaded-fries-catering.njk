<script>
(function(){
  // ---------------------------------------------------------------------
  // Analytics-events (gated door dezelfde cookie-toestemming als de rest
  // van de site). Elke trackEvent-aanroep hieronder is een duidelijk
  // benoemd conversiepunt, klaar om in GA4/Meta Pixel te herkennen of om
  // later te koppelen aan een eigen dashboard.
  // ---------------------------------------------------------------------
  function trackEvent(name, params){
    if (window.gtag) { window.gtag('event', name, params || {}); }
    if (window.fbq) { window.fbq('trackCustom', name, params || {}); }
  }

  var heroPrimair = document.getElementById('heroCtaPrimair');
  if (heroPrimair) heroPrimair.addEventListener('click', function(){ trackEvent('loaded_fries_hero_cta_click'); });

  var heroSecundair = document.getElementById('heroCtaSecundair');
  if (heroSecundair) heroSecundair.addEventListener('click', function(){ trackEvent('loaded_fries_menu_bekeken'); });

  var alleMogelijkheden = document.getElementById('ctaAlleMogelijkheden');
  if (alleMogelijkheden) alleMogelijkheden.addEventListener('click', function(){ trackEvent('loaded_fries_hero_cta_click', { source: 'smaken_sectie' }); });

  var finalCta = document.getElementById('finalCta');
  if (finalCta) finalCta.addEventListener('click', function(){ trackEvent('loaded_fries_hero_cta_click', { source: 'slot_cta' }); });

  var phoneClick = document.getElementById('phoneClick');
  if (phoneClick) phoneClick.addEventListener('click', function(){ trackEvent('loaded_fries_telefoon_klik'); });

  // "Menu bekeken" — vuurt eenmalig zodra de smaken-sectie in beeld komt
  var smakenSection = document.getElementById('smaken');
  if (smakenSection && 'IntersectionObserver' in window) {
    var seenMenu = false;
    var menuObserver = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting && !seenMenu) { seenMenu = true; trackEvent('loaded_fries_menu_bekeken'); menuObserver.disconnect(); }
      });
    }, { threshold: 0.3 });
    menuObserver.observe(smakenSection);
  }

  // ---------------------------------------------------------------------
  // "Bereken je aanvraag" — live richtprijs-indicatie + gestructureerde
  // payload die klaarstaat voor een toekomstige backend/API-koppeling
  // (agenda check, capaciteit, offertegenerator, WeFact, etc).
  // ---------------------------------------------------------------------

  // TODO(Maikel): vervang door de echte prijs per persoon zodra bekend.
  var PRICE_PER_PERSON_INDICATIE = 12.50;

  var guestsInput = document.getElementById('lf-event-guests');
  var estimateBox = document.getElementById('lfEstimate');

  function updateEstimate(){
    if (!guestsInput || !estimateBox) return;
    var guests = parseInt(guestsInput.value, 10);
    if (!guests || guests < 1) {
      estimateBox.innerHTML = 'Richtprijs-indicatie: vul het aantal personen in om een indicatie te zien. <br><span style="font-size:.8rem">Dit is een grove inschatting op basis van een placeholder-prijs per persoon — geen offerte.</span>';
      return;
    }
    var total = guests * PRICE_PER_PERSON_INDICATIE;
    estimateBox.innerHTML = 'Richtprijs-indicatie voor ' + guests + ' personen: <b>&euro;' + total.toLocaleString('nl-NL', {minimumFractionDigits:2, maximumFractionDigits:2}) + '</b> <br><span style="font-size:.8rem">Gebaseerd op een placeholder van &euro;' + PRICE_PER_PERSON_INDICATIE.toFixed(2).replace('.', ',') + ' per persoon, excl. eventuele bezorgkosten. Dit is geen offerte.</span>';
  }
  if (guestsInput) {
    guestsInput.addEventListener('input', updateEstimate);
    updateEstimate();
  }

  var form = document.getElementById('lfCalcForm');
  var statusEl = document.getElementById('lfFormStatus');
  var formStarted = false;

  function markFormStarted(){
    if (formStarted) return;
    formStarted = true;
    trackEvent('loaded_fries_offerteformulier_gestart');
  }
  if (form) {
    form.addEventListener('focusin', markFormStarted, { once: true });
  }

  // FORMSPREE_ENDPOINT: maak een gratis formulier aan op formspree.io (of
  // koppel hier je eigen custom endpoint) en vul de URL hieronder in.
  // Zolang dit een placeholder is, wordt er nergens naartoe verstuurd —
  // de aanvraag wordt alleen gestructureerd gelogd, zodat er niets
  // stilzwijgend verloren gaat of naar een niet-bestaand adres gaat.
  var FORMSPREE_ENDPOINT = 'PLAATS_HIER_JE_FORMSPREE_OF_CUSTOM_ENDPOINT';

  function buildPayload(){
    return {
      customer: {
        name: document.getElementById('lf-customer-name').value,
        email: document.getElementById('lf-customer-email').value,
        phone: document.getElementById('lf-customer-phone').value
      },
      event: {
        event_type: document.getElementById('lf-event-type').value,
        date: document.getElementById('lf-event-date').value,
        start_time: document.getElementById('lf-event-start-time').value,
        guests: parseInt(document.getElementById('lf-event-guests').value, 10) || null,
        notes: document.getElementById('lf-event-notes').value
      },
      location: {
        postcode: document.getElementById('lf-location-postcode').value,
        city: document.getElementById('lf-location-city').value
      },
      source: 'loaded-fries-catering-landingspagina',
      submitted_at: new Date().toISOString()
    };
  }

  if (form) {
    form.addEventListener('submit', function(ev){
      ev.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      var payload = buildPayload();
      trackEvent('loaded_fries_offerteformulier_verzonden', { event_type: payload.event.event_type, guests: payload.event.guests });

      if (statusEl) statusEl.textContent = 'Bezig met versturen...';

      if (FORMSPREE_ENDPOINT.indexOf('https://') === 0) {
        fetch(FORMSPREE_ENDPOINT, {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        }).then(function(r){
          if (statusEl) statusEl.textContent = r.ok
            ? 'Bedankt! We nemen binnen 1 werkdag contact met je op.'
            : 'Er ging iets mis. Probeer het later opnieuw of bel ons op 0318 – 514 916.';
          if (r.ok) form.reset();
        }).catch(function(){
          if (statusEl) statusEl.textContent = 'Er ging iets mis. Probeer het later opnieuw of bel ons op 0318 – 514 916.';
        });
      } else {
        // Nog geen echt endpoint gekoppeld: log de gestructureerde
        // aanvraag zodat de flow end-to-end te testen is, en toon
        // alvast de bevestiging aan de bezoeker.
        console.log('[Loaded Fries aanvraag — nog niet gekoppeld aan een backend]', payload);
        if (statusEl) statusEl.textContent = 'Bedankt! Je aanvraag is genoteerd — we nemen snel contact met je op.';
        form.reset();
        updateEstimate();
      }
    });
  }

  // scroll-reveal (zelfde patroon als de rest van de site)
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {threshold:0.12});
    document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('in'); });
  }

  // FAQ-accordion (zelfde patroon als veelgestelde-vragen.html)
  document.querySelectorAll('.faq-item').forEach(function(item){
    var btn = item.querySelector('.faq-q');
    var answer = item.querySelector('.faq-a');
    btn.addEventListener('click', function(){
      var isOpen = item.classList.contains('is-open');
      document.querySelectorAll('.faq-item.is-open').forEach(function(other){
        if (other !== item) {
          other.classList.remove('is-open');
          other.querySelector('.faq-a').style.maxHeight = null;
          other.querySelector('.faq-q').setAttribute('aria-expanded', 'false');
        }
      });
      if (isOpen) {
        item.classList.remove('is-open');
        answer.style.maxHeight = null;
        btn.setAttribute('aria-expanded', 'false');
      } else {
        item.classList.add('is-open');
        answer.style.maxHeight = answer.scrollHeight + 'px';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
})();
</script>
<script src="/pwa-install.js" defer></script>
</body>
